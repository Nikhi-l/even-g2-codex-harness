# For docker compose hosting; never put real tokens in committed files.
G2_HARNESS_DOMAIN=glasses.example.com
G2_HARNESS_ORIGIN=https://glasses.example.com
G2_HARNESS_TOKEN=replace-with-a-random-token-of-at-least-32-characters
# If the packaged Even Hub WebView sends a different Origin, add the exact
# observed origin here. Never use *. Empty means same-origin only.
G2_HARNESS_ALLOWED_ORIGINS=
