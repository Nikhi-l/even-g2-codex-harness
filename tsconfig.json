{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true,
    "noUncheckedIndexedAccess": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "skipLibCheck": true, "esModuleInterop": true, "resolveJsonModule": true,
    "types": ["node", "vite/client"]
  },
  "include": ["src", "tests", "vite.config.ts", "vitest.config.ts", "playwright.config.ts"]
}
